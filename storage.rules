rules_version = '2';
// Despliegue: firebase deploy --only storage
// Las fotos de lecturas se guardan en readings/{userId}/{archivo}
// La imagen del encabezado del reporte: variables/reporte-imagen.jpg
service firebase.storage {
  match /b/{bucket}/o {
    match /readings/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /variables/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
